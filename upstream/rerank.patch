+    def _apply_rerank(self, query: str, ranked: list[dict], limit: int) -> list[dict]:
+        """Run the optional rerank hook over every scored candidate, before the final slice.
+
+        The hook returns the candidates it wants, best first, or None to keep the provider order. It can only
+        reorder: it receives copies of the scored rows, an id outside *ranked* is dropped, duplicates and
+        non-dicts are ignored, and the provider order fills the list back up to *limit*. An exception, or a call
+        over ``rerank_timeout_ms``, is logged and never fails the search: a broken hook costs a reranked ranking,
+        not a turn.
+        """
+        started = time.monotonic()
+        try:
+            picked = self.rerank_hook(query, [dict(f) for f in ranked], limit)
+        except Exception as exc:  # noqa: BLE001 - a hook must never fail a search
+            logger.warning("holographic: rerank hook failed, keeping provider order (%s)", exc)
+            return ranked
+        elapsed_ms = (time.monotonic() - started) * 1000.0
+        if elapsed_ms > self.rerank_timeout_ms:
+            logger.warning("holographic: rerank hook took %.0fms (budget %dms)", elapsed_ms, self.rerank_timeout_ms)
+        if not isinstance(picked, list):
+            if picked is not None:
+                logger.warning("holographic: rerank hook returned %s, keeping provider order", type(picked).__name__)
+            return ranked
+        by_id = {f["fact_id"]: f for f in ranked}
+        out: list[dict] = []
+        seen: set[int] = set()
+        for item in picked:
+            fact_id = item.get("fact_id") if isinstance(item, dict) else None
+            if isinstance(fact_id, int) and fact_id in by_id and fact_id not in seen:
+                seen.add(fact_id)
+                # the provider's row, not the hook's copy: score and trust cannot be forged
+                out.append(by_id[fact_id])
+        return out + [f for f in ranked if f["fact_id"] not in seen]
